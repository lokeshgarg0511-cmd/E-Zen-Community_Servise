# ══════════════════════════════════════════════════════════════════════════════
# E-ZEN: SMART ACADEMIC MONITORING AND INSTITUTIONAL MANAGEMENT PLATFORM
# Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# ── DATABASE ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local mongodb://localhost:27017/ezen)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/ezen?retryWrites=true&w=majority

# ── AUTHENTICATION & SECURITY ─────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Client Origin (CORS & redirect whitelist)
CLIENT_URL=http://localhost:5173

# ── EMAIL / SMTP (OTP & Notification Alerts) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="E-Zen Institutional Portal <no-reply@ezen.edu.in>"
OTP_EXPIRE_MINUTES=10

# ── AI ASSISTANT / GEMINI API ─────────────────────────────────────────────────
# Used for role-grounded academic intelligence and automated intervention summaries
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── SOCIAL SSO AUTHENTICATION (Optional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
APPLE_CLIENT_ID=your_apple_service_id_here

# ── PAYMENT GATEWAY (Razorpay / Stripe for simulated / live fee collections) ─
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
